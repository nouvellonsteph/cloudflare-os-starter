{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-sandbox",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "containers": [{
    "class_name": "SandboxWorkspace",
    "scheduling_policy": "durable_object",
    "images": { "workspace": { "dockerfile": "./Dockerfile" } }
  }],
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACES", "class_name": "SandboxWorkspace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SandboxWorkspace", "SandboxGatekeeper"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }]
}
