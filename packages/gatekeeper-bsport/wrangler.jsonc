{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-bsport",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "BSPORT_ACCOUNTS", "class_name": "BsportAccount" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BsportAccount", "BsportGatekeeper"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],
  "observability": { "enabled": false }
}
